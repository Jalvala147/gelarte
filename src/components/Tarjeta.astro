---
import { enlaceWhatsapp, negocio } from "../data/negocio";
import { formatoPrecio, normalizar } from "../lib/texto";
import { imagenSegura, nombreCategoria, type Producto } from "../lib/tipos";

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const categoria = nombreCategoria(producto.categoria);
const consulta = producto.precio <= 0;
const precio = formatoPrecio(producto.precio);
const foto = imagenSegura(producto.imagen);
const generica = foto === "/marca/logo.jpg";
const encuadre = producto.encuadre ?? 50;
const pedido = enlaceWhatsapp(
  consulta
    ? `Hola, quiero apartar ${producto.nombre} de ${negocio.nombre}.`
    : `Hola, quiero apartar ${producto.nombre} de ${negocio.nombre} (${precio}).`,
);
const buscar = normalizar(
  `${producto.nombre} ${producto.descripcion} ${categoria} ${(producto.etiquetas ?? []).join(" ")}`,
);
---

<article
  class="tarjeta flex flex-col overflow-hidden rounded-[1.75rem] border border-ocre/50 bg-white shadow-[0_12px_32px_rgba(123,63,27,0.06)] transition duration-200 hover:-translate-y-0.5"
  data-producto
  data-categoria={producto.categoria}
  data-buscar={buscar}
>
  <div class="relative aspect-square overflow-hidden bg-rosa">
    <img
      src={foto}
      alt={`Gelatina de ${producto.nombre}`}
      width="640"
      height="640"
      loading="lazy"
      decoding="async"
      class:list={["absolute inset-0 h-full w-full", generica ? "object-contain p-8" : "object-cover"]}
      style={generica ? undefined : `object-position: center ${encuadre}%`}
    />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="text-xs font-bold tracking-[0.16em] text-salvia uppercase">{categoria}</p>
    <h2 class="font-serif text-3xl leading-none font-semibold break-words">{producto.nombre}</h2>
    <p class="text-sm leading-relaxed text-marron/80">{producto.descripcion}</p>
    <div class="mt-auto flex items-end justify-between gap-3 pt-2">
      <p class="min-w-0">
        <span class:list={["font-serif leading-none", consulta ? "text-2xl" : "text-3xl sm:text-4xl"]}>{precio}</span>
        <span class="mt-1 block text-sm text-marron/70">{producto.unidad}</span>
      </p>
      <a class="boton shrink-0" href={pedido} target="_blank" rel="noopener noreferrer">Pedir</a>
    </div>
  </div>
</article>
