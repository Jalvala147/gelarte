---
import { negocio } from "../data/negocio";

const año = new Date().getFullYear();
---

<footer class="mt-8 border-t border-ocre/40">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-serif text-2xl leading-none tracking-wide">{negocio.nombre}</p>
    <p class="text-sm text-marron/70">Gelatinas caseras · {año}</p>
    <a href="/gestionar" class="text-sm font-bold text-salvia">Gestión del catálogo</a>
  </div>
</footer>
