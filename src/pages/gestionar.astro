---
import Encabezado from "../components/Encabezado.astro";
import Pie from "../components/Pie.astro";
import Base from "../layouts/Base.astro";
import { negocio } from "../data/negocio";
import { COOKIE, gestionConfigurada, sesionValida } from "../lib/auth";
import { destinoGuardado, listarTodo } from "../lib/catalogo";
import { formatoPrecio } from "../lib/texto";
import { CATEGORIAS, imagenSegura, nombreCategoria } from "../lib/tipos";

Astro.response.headers.set("Cache-Control", "no-store");

const authed = sesionValida(Astro.cookies.get(COOKIE)?.value);
const configurada = gestionConfigurada();
const destino = destinoGuardado();
let productos: Awaited<ReturnType<typeof listarTodo>> = [];
let errorCatalogo = "";
if (authed) {
  try {
    productos = await listarTodo();
  } catch (error) {
    errorCatalogo = error instanceof Error ? error.message : "No se pudo abrir el catálogo.";
  }
}
---

<Base
  titulo={`Gestión · ${negocio.nombre}`}
  descripcion={`Espacio privado para agregar y actualizar las gelatinas de ${negocio.nombre}.`}
  robots="noindex, nofollow"
>
  <Encabezado />
  <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-6 sm:py-10">
    {
      !authed ? (
        <section class="mx-auto max-w-md rounded-[2rem] bg-white p-6 shadow-[0_12px_32px_rgba(123,63,27,0.06)] sm:p-8">
          <h1 class="font-serif text-4xl leading-none font-semibold sm:text-5xl">Gestión</h1>
          <p class="mt-4 leading-relaxed">
            Aquí la dueña agrega un sabor nuevo: foto, descripción, categoría y precio.
          </p>
          {
            configurada ? (
              <form id="entrar" class="mt-6 grid gap-4">
                <label>
                  <span class="mb-2 block text-sm font-bold">Contraseña</span>
                  <input class="campo" type="password" name="password" autocomplete="current-password" required />
                </label>
                <p data-error class="font-bold" hidden role="alert" />
                <button class="boton w-full" type="submit">Entrar</button>
                {import.meta.env.DEV && <p class="text-sm text-marron/70">En esta copia local la contraseña es gelarte.</p>}
              </form>
            ) : (
              <p class="mt-6 rounded-2xl bg-rosa p-4" role="status">
                Falta definir ADMIN_PASSWORD y SESSION_SECRET en Vercel para abrir la gestión.
              </p>
            )
          }
        </section>
      ) : (
        <div class="grid gap-8">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h1 class="font-serif text-4xl leading-none font-semibold sm:text-5xl">Catálogo</h1>
              <p class="mt-3 max-w-xl leading-relaxed">
                Agrega una gelatina nueva o abre una existente para corregir sus datos y acomodar la foto.
              </p>
            </div>
            <button id="salir" class="boton-linea" type="button">Salir</button>
          </div>

          {
            destino === "ninguno" && (
              <p class="rounded-2xl bg-rosa p-4" role="status">
                Esta copia todavía no puede guardar cambios. Conecta un almacenamiento Blob en Vercel.
              </p>
            )
          }
          {
            destino === "local" && (
              <p class="rounded-2xl bg-white p-4 text-sm">
                En esta copia local, los cambios se guardan solo en este equipo.
              </p>
            )
          }
          {
            destino === "blob" && (
              <p class="rounded-2xl bg-white p-4 text-sm">
                Los cambios de esta página se guardan en internet y se ven al momento.
              </p>
            )
          }

          <form id="nueva" class="grid gap-4 rounded-[2rem] bg-white p-4 shadow-[0_12px_32px_rgba(123,63,27,0.06)] sm:p-6">
            <h2 class="font-serif text-3xl leading-none font-semibold">Nueva gelatina</h2>
            <label>
              <span class="mb-2 block text-sm font-bold">Nombre</span>
              <input class="campo" name="nombre" required maxlength="60" autocomplete="off" />
            </label>
            <label>
              <span class="mb-2 block text-sm font-bold">Descripción</span>
              <textarea class="campo min-h-24" name="descripcion" required maxlength="240" />
            </label>
            <label>
              <span class="mb-2 block text-sm font-bold">Palabras de búsqueda</span>
              <input class="campo" name="etiquetas" maxlength="240" placeholder="chocolate, fresa" autocomplete="off" />
              <span class="mt-2 block text-sm text-marron/70">Sepáralas con comas. La gelatina aparece al buscar cualquiera de esas palabras.</span>
            </label>
            <div class="grid gap-4 sm:grid-cols-3">
              <label>
                <span class="mb-2 block text-sm font-bold">Categoría</span>
                <select class="campo" name="categoria" required>
                  {CATEGORIAS.map((categoria) => (
                    <option value={categoria.id}>{categoria.nombre}</option>
                  ))}
                </select>
              </label>
              <label>
                <span class="mb-2 block text-sm font-bold">Precio</span>
                <input class="campo" name="precio" type="number" inputmode="numeric" min="0" max="9999" step="1" />
                <span class="mt-2 block text-sm text-marron/70">Vacío o 0: se consulta por WhatsApp.</span>
              </label>
              <label>
                <span class="mb-2 block text-sm font-bold">Tamaño</span>
                <input class="campo" name="unidad" value="Mediana" maxlength="24" />
              </label>
            </div>
            <label>
              <span class="mb-2 block text-sm font-bold">Foto</span>
              <input class="campo" name="imagen" type="file" accept="image/*" />
              <span class="mt-2 block text-sm text-marron/70">Si no eliges foto, se usa el logo. Puede salir del teléfono.</span>
            </label>
            <div class="grid gap-4 sm:grid-cols-[12rem_1fr] sm:items-center" data-acomodo hidden>
              <div
                data-marco
                class="relative aspect-square cursor-grab touch-none overflow-hidden rounded-2xl bg-rosa select-none"
              >
                <img
                  data-preview
                  alt="Así se verá en el catálogo"
                  class="pointer-events-none absolute inset-0 h-full w-full object-cover"
                  style="object-position: center 50%"
                />
              </div>
              <label>
                <span class="mb-2 block text-sm font-bold">Acomodar la foto</span>
                <span class="mb-3 block text-sm text-marron/70">
                  Arrastra la foto, o mueve la barra, para subirla o bajarla y centrar la gelatina.
                </span>
                <input class="encuadre" data-encuadre type="range" name="encuadre" min="0" max="100" step="1" value="50" />
                <span class="mt-1 flex justify-between text-xs font-bold text-marron/70">
                  <span>Arriba</span><span>Centro</span><span>Abajo</span>
                </span>
              </label>
            </div>
            <p data-error class="font-bold" hidden role="alert" />
            <button class="boton w-full sm:w-auto" type="submit">Publicar gelatina</button>
          </form>

          {
            errorCatalogo ? (
              <p class="rounded-[1.5rem] bg-white p-6 font-bold" role="alert">{errorCatalogo}</p>
            ) : (
              <div id="editar" class="grid scroll-mt-24 gap-3">
                <h2 class="font-serif text-3xl leading-none font-semibold">Editar existentes</h2>
                <p class="text-sm text-marron/70">Abre una gelatina para cambiar sus datos o centrar la foto.</p>
                {productos.length === 0 && <p class="rounded-[1.5rem] bg-white p-6">El catálogo está vacío.</p>}
                {productos.map((producto) => (
                  <details class="rounded-[1.5rem] border border-ocre/50 bg-white">
                    <summary class="flex cursor-pointer items-center gap-3 p-4">
                      <img
                        src={imagenSegura(producto.imagen)}
                        alt=""
                        width="56"
                        height="56"
                        class="h-14 w-14 shrink-0 rounded-xl bg-rosa object-cover"
                        style={`object-position: center ${producto.encuadre ?? 50}%`}
                      />
                      <span class="min-w-0 flex-1">
                        <span class="block truncate font-serif text-2xl leading-none">{producto.nombre}</span>
                        <span class="mt-1 block text-sm text-salvia">
                          {nombreCategoria(producto.categoria)} · {formatoPrecio(producto.precio)}
                          {!producto.visible && <span class="ml-2 font-bold text-marron">Oculta</span>}
                        </span>
                      </span>
                      <span class="shrink-0 text-sm font-bold">Editar</span>
                    </summary>
                    <form class="grid gap-4 border-t border-ocre/30 p-4" data-editar data-id={producto.id}>
                      <div class="grid gap-4 sm:grid-cols-[12rem_1fr] sm:items-center">
                        <div
                          data-marco
                          class="relative aspect-square cursor-grab touch-none overflow-hidden rounded-2xl bg-rosa select-none"
                        >
                          <img
                            data-preview
                            src={imagenSegura(producto.imagen)}
                            alt={`Encuadre de ${producto.nombre}`}
                            class="pointer-events-none absolute inset-0 h-full w-full object-cover"
                            style={`object-position: center ${producto.encuadre ?? 50}%`}
                          />
                        </div>
                        <label>
                          <span class="mb-2 block text-sm font-bold">Acomodar la foto</span>
                          <span class="mb-3 block text-sm text-marron/70">
                            Arrastra la foto, o mueve la barra, para subirla o bajarla y centrar la gelatina.
                          </span>
                          <input
                            class="encuadre"
                            data-encuadre
                            type="range"
                            name="encuadre"
                            min="0"
                            max="100"
                            step="1"
                            value={producto.encuadre ?? 50}
                          />
                          <span class="mt-1 flex justify-between text-xs font-bold text-marron/70">
                            <span>Arriba</span><span>Centro</span><span>Abajo</span>
                          </span>
                        </label>
                      </div>
                      <label>
                        <span class="mb-2 block text-sm font-bold">Nombre</span>
                        <input class="campo" name="nombre" required maxlength="60" value={producto.nombre} />
                      </label>
                      <label>
                        <span class="mb-2 block text-sm font-bold">Descripción</span>
                        <textarea class="campo min-h-24" name="descripcion" required maxlength="240">{producto.descripcion}</textarea>
                      </label>
                      <label>
                        <span class="mb-2 block text-sm font-bold">Palabras de búsqueda</span>
                        <input class="campo" name="etiquetas" maxlength="240" value={(producto.etiquetas ?? []).join(", ")} placeholder="chocolate, fresa" />
                        <span class="mt-2 block text-sm font-normal text-marron/70">Sepáralas con comas. Por ejemplo: chocolate, fresa.</span>
                      </label>
                      <div class="grid gap-4 sm:grid-cols-3">
                        <label>
                          <span class="mb-2 block text-sm font-bold">Categoría</span>
                          <select class="campo" name="categoria">
                            {CATEGORIAS.map((categoria) => (
                              <option value={categoria.id} selected={categoria.id === producto.categoria}>
                                {categoria.nombre}
                              </option>
                            ))}
                          </select>
                        </label>
                        <label>
                          <span class="mb-2 block text-sm font-bold">Precio</span>
                          <input class="campo" name="precio" type="number" min="0" max="9999" step="1" value={producto.precio > 0 ? producto.precio : undefined} />
                          <span class="mt-2 block text-sm font-normal text-marron/70">Vacío o 0: se consulta.</span>
                        </label>
                        <label>
                          <span class="mb-2 block text-sm font-bold">Unidad</span>
                          <input class="campo" name="unidad" maxlength="24" value={producto.unidad} />
                        </label>
                      </div>
                      <label class="flex items-center gap-3 font-bold">
                        <input type="checkbox" name="visible" checked={producto.visible} class="h-5 w-5 accent-marron" />
                        Visible en el catálogo
                      </label>
                      <label>
                        <span class="mb-2 block text-sm font-bold">Cambiar foto</span>
                        <input class="campo" name="imagen" type="file" accept="image/*" />
                      </label>
                      <p data-error class="font-bold" hidden role="alert" />
                      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                        <button class="boton w-full sm:w-auto" type="submit">Guardar cambios</button>
                        <button class="boton-linea w-full sm:w-auto" type="button" data-borrar={producto.id}>Quitar</button>
                      </div>
                    </form>
                  </details>
                ))}
              </div>
            )
          }
        </div>
      )
    }
  </main>
  <Pie />
</Base>

<script>
  import "../scripts/gestionar.ts";
</script>
